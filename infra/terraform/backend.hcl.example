# Copy to backend.hcl (gitignored), put in the bootstrap stack's state_bucket output, then:
#   terraform init -backend-config=backend.hcl
bucket       = "jackdaw-arena-tfstate-123456789012"
key          = "arena/prod.tfstate"
region       = "us-west-2"
encrypt      = true
use_lockfile = true # S3-native locking: no DynamoDB table
